generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ProductTemplate {
  id                    String           @id @default(cuid())
  title                 String
  brand                 String?
  supplierId            String?
  supplier              Supplier?        @relation("ProductTemplateSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  category              String           @default("Личные вещи")
  goodsType             String           @default("Одежда, обувь, аксессуары")
  productType           String           @default("Футболки и топы")
  adType                String           @default("Товар приобретен на продажу")
  gender                String           @default("Мужская")
  condition             String           @default("Новое")
  basePrice             Int              @default(0)
  description           String           @default("")
  generatedDescription  String?
  avitoCategorySlug     String?
  avitoCategoryName     String?
  avitoFieldsJson       String           @default("{}")
  publicationErrorsJson String           @default("[]")
  lastApiSyncAt         DateTime?
  status                String           @default("DRAFT")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  variants              ProductVariant[]
  photos                PhotoAsset[]
  colorGroups           ProductColorGroup[]
  publicationRuns       PublicationRun[]
  customerOrders        CustomerOrder[]

  @@index([supplierId])
}

model ProductColorGroup {
  id              String          @id @default(cuid())
  productId       String
  product         ProductTemplate @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?       @relation("ProductColorGroupSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  color           String
  avitoColorValue String?
  basePrice       Int             @default(0)
  defaultStockQty Int             @default(1)
  description     String          @default("")
  avitoFieldsJson String          @default("{}")
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([productId, color])
  @@index([supplierId])
  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  product           ProductTemplate @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerOrders    CustomerOrder[]
  color             String
  size              String
  sku               String          @unique
  price             Int
  stockQty          Int             @default(1)
  avitoFieldsJson   String          @default("{}")
  needsSync         Boolean         @default(false)
  avitoExternalId   String?
  publicationStatus String          @default("DRAFT")
  lastPriceSyncAt   DateTime?
  lastStockSyncAt   DateTime?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([productId, color, size])
  @@index([productId, color])
}

model Supplier {
  id                     String              @id @default(cuid())
  name                   String
  contactName            String?
  phone                  String?
  whatsapp               String?
  telegram               String?
  website                String?
  notes                  String              @default("")
  defaultMessageTemplate String              @default("")
  active                 Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  productTemplates       ProductTemplate[]   @relation("ProductTemplateSupplier")
  colorGroups            ProductColorGroup[] @relation("ProductColorGroupSupplier")
  supplierTasks          SupplierTask[]

  @@index([active, name])
}

model CustomerOrder {
  id             String           @id @default(cuid())
  avitoOrderId   String           @unique
  avitoItemId    String?
  avitoChatId    String?
  buyerName      String?
  buyerPhone     String?
  itemTitle      String?
  color          String?
  size           String?
  quantity       Int              @default(1)
  price          Int              @default(0)
  status         String           @default("NEW")
  deliveryText   String?
  productId      String?
  product        ProductTemplate? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  rawJson        String           @default("{}")
  avitoCreatedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  supplierTask   SupplierTask?

  @@index([status, avitoCreatedAt])
  @@index([productId])
  @@index([variantId])
  @@index([avitoItemId])
}

model SupplierTask {
  id               String        @id @default(cuid())
  orderId          String        @unique
  order            CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  generatedMessage String        @default("")
  status           String        @default("NEW")
  notes            String        @default("")
  copiedAt         DateTime?
  contactedAt      DateTime?
  doneAt           DateTime?
  error            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([supplierId, status])
  @@index([status])
}

model BulkPriceOperation {
  id           String   @id @default(cuid())
  scope        String   @default("PRODUCT")
  filterJson   String   @default("{}")
  mode         String
  value        Float
  rounding     String   @default("NONE")
  previewCount Int      @default(0)
  appliedCount Int      @default(0)
  status       String   @default("PREVIEW")
  errorsJson   String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PhotoAsset {
  id           String          @id @default(cuid())
  productId    String
  product      ProductTemplate @relation(fields: [productId], references: [id], onDelete: Cascade)
  originalName String
  fileName     String
  mimeType     String
  sizeBytes    Int
  color        String?
  sortOrder    Int             @default(0)
  localPath    String
  publicUrl    String
  createdAt    DateTime        @default(now())

  @@index([productId, color])
}

model PublicationRun {
  id           String           @id @default(cuid())
  productId    String?
  product      ProductTemplate? @relation(fields: [productId], references: [id], onDelete: SetNull)
  feedVersion  String
  status       String           @default("SUBMITTED")
  submittedAt  DateTime         @default(now())
  reportStatus String?
  errorsJson   String           @default("[]")
  warningsJson String           @default("[]")
  rawReport    String?
}

model AvitoSettings {
  id                    String   @id @default("default")
  clientId              String?
  clientSecretEncrypted String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  avitoUserId           String?
  sellerLocation        String?
  contactName           String?
  phone                 String?
  email                 String?
  address               String?
  publicFeedUrl         String?
  redirectUrl           String?
  autoloadReportEmail   String?
  autoloadScheduleJson  String   @default("[]")
  capabilitiesJson      String   @default("{}")
  updatedAt             DateTime @updatedAt
}

model AvitoCatalogCache {
  key       String   @id
  dataJson  String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model Review {
  id            String            @id @default(cuid())
  avitoReviewId String            @unique
  rating        Int
  text          String
  authorName    String?
  itemId        String?
  itemTitle     String?
  status        String            @default("NEW")
  rawJson       String            @default("{}")
  avitoCreatedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  replyDraft    ReviewReplyDraft?

  @@index([rating, status])
  @@index([avitoCreatedAt])
}

model ReviewReplyDraft {
  id         String         @id @default(cuid())
  reviewId   String         @unique
  review     Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  templateId String?
  template   ReplyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  text       String
  status     String         @default("DRAFT")
  sentAt     DateTime?
  error      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([templateId])
}

model ReplyTemplate {
  id        String             @id @default(cuid())
  name      String
  ratingMin Int                @default(1)
  ratingMax Int                @default(5)
  keywords  String             @default("")
  text      String
  priority  Int                @default(0)
  active    Boolean            @default(true)
  autoSend  Boolean            @default(false)
  kind      String             @default("REVIEW")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  drafts    ReviewReplyDraft[]

  @@index([kind, active, priority])
}

model AutomationState {
  id                 String    @id @default("default")
  onlineEnabled      Boolean   @default(false)
  reviewsEnabled     Boolean   @default(true)
  draftsEnabled      Boolean   @default(true)
  reviewAutoSendEnabled Boolean @default(true)
  messagesEnabled    Boolean   @default(false)
  messageAutoRepliesEnabled Boolean @default(false)
  reportsEnabled     Boolean   @default(true)
  ordersEnabled      Boolean   @default(true)
  status             String    @default("IDLE")
  lastOnlinePingAt   DateTime?
  lastReviewsSyncAt  DateTime?
  lastReviewAutoSendAt DateTime?
  lastMessagesSyncAt DateTime?
  lastMessageRulesAt DateTime?
  lastReportsSyncAt DateTime?
  lastOrdersSyncAt   DateTime?
  lastError          String?
  capabilitiesJson   String    @default("{}")
  updatedAt          DateTime  @updatedAt
}

model MessageChat {
  id            String            @id @default(cuid())
  avitoChatId   String            @unique
  title         String?
  buyerName     String?
  itemId        String?
  itemTitle     String?
  unreadCount   Int               @default(0)
  lastMessageAt DateTime?
  rawJson       String            @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      Message[]
  replyLogs     MessageReplyLog[]

  @@index([lastMessageAt])
}

model Message {
  id             String            @id @default(cuid())
  chatId         String
  chat           MessageChat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  avitoMessageId String            @unique
  direction      String
  text           String
  authorName     String?
  sentAt         DateTime?
  rawJson        String            @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  replyLogs      MessageReplyLog[]

  @@index([chatId, sentAt])
  @@index([direction])
}

model MessageRule {
  id              String            @id @default(cuid())
  name            String
  keywords        String            @default("")
  responseText    String
  priority        Int               @default(0)
  cooldownSeconds Int               @default(900)
  oncePerChat     Boolean           @default(true)
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  replyLogs       MessageReplyLog[]

  @@index([active, priority])
}

model MessageReplyLog {
  id        String       @id @default(cuid())
  chatId    String
  chat      MessageChat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  ruleId    String?
  rule      MessageRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  text      String
  status    String       @default("PENDING")
  sentAt    DateTime?
  error     String?
  rawJson   String       @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([chatId, status])
  @@index([messageId])
  @@index([ruleId])
}

model AutomationEvent {
  id          String   @id @default(cuid())
  task        String
  status      String
  message     String?
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([task, createdAt])
  @@index([status])
}
