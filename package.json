    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/forms": "0.5.11",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
